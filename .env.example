# Copy to .env (local only, never commit). Set at least one key.
GEMINI_API_KEY=your_key_here
# Optional: leave blank to auto-pick the best available Gemini Flash model
LLM_MODEL=
MAX_CARDS_PER_RUN=40
# Main provider (console.groq.com). GROQ_MODEL optional: blank = auto-pick
GROQ_API_KEY=
GROQ_MODEL=
# LLM_ORDER=groq,gemini
